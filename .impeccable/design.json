  "narrative": {
    "northStar": "The Control Room",
    "overview": "InfluencerHub is a calm place to oversee work being done on your behalf. Deep ink surfaces frame the workspace, light cards hold the work, and colour is kept for status: what is running, what is waiting for you, and what has gone wrong.\n\nThe person is the operator, not the audience. Agent steps appear live beside the work, and every decision point stands out from the surfaces around it. The soft serif in headings keeps the room from feeling industrial, and Pip and the named crew give the system a friendly face without loosening its discipline.\n\nDensity is moderate. Screens are built for reading evidence and making a decision, not for scanning large tables of numbers.",
    "keyCharacteristics": [
      "Ink navy frames with light working surfaces",
      "Colour reserved for status and primary action",
      "Flat surfaces separated by hairline borders",
      "Rings and shadows that signal state",
      "A soft serif for headings over a clean geometric sans"
    ],
    "rules": [
      {
        "name": "The Token First Rule",
        "body": "Use the `:root` variables in `src/styles.css`. Older screens hard-code greys and greens such as #1f7a63, #111827 and #e5e7eb. Treat those as legacy and move them to tokens when a screen is next changed.",
        "section": "colors"
      },
      {
        "name": "The Amber Means You Rule",
        "body": "Amber marks a place where the agent has stopped and a person decides. Don't use it for general warnings or decoration.",
        "section": "colors"
      },
      {
        "name": "The Serif Stays Up Top Rule",
        "body": "Fraunces is for the logo and page-level headings. Panels, cards, controls and data use Outfit.",
        "section": "typography"
      },
      {
        "name": "The State Earns Depth Rule",
        "body": "A surface only gains a ring or shadow when something about its state has changed. The resting shadow and hover lift on campaign cards predate this rule and are legacy.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the `:root` tokens in `src/styles.css` for new work and when changing older screens.",
      "Do keep amber for approval gates and \"needs you\" states.",
      "Do use `green` or `amber-ink` for coloured text on light surfaces, because `mint` and `amber` lack the contrast.",
      "Do keep agent activity visible next to the work on agent pages.",
      "Do separate surfaces at rest with a 1px `line` border."
    ],
    "donts": [
      "Don't add resting shadows or hover lift to new cards.",
      "Don't add new hard-coded greys or greens when a token covers the role.",
      "Don't use Fraunces inside cards, controls or data.",
      "Don't use amber for general warnings or decoration."
    ]
  }
}